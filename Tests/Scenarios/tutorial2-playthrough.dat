 "script": {
  "Version": 1,
  "Triggers": [
   {
    "Name": "Welcome",
    "Enabled": true,
    "Condition": 0,
    "Actions": [
     {
      "Type": 1,
      "Zoom": 0,
      "Seconds": 1.0,
      "AtUnit": "Truck"
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Commander",
        "Text": "The raiders hold the village at the end of this road, recruit. It is a long walk, so we drive.",
        "Sound": "",
        "Portrait": 0
       },
       {
        "Character": "Placeholder Scout",
        "Text": "This is a truck. It can't fight, but it carries two squads on foot, and it is fast on a road.",
        "Sound": "",
        "Portrait": 1
       },
       {
        "Character": "Placeholder Scout",
        "Text": "Select the grunt, then click the truck: he climbs aboard.",
        "Sound": "",
        "Portrait": 1
       }
      ]
     },
     {
      "Type": 2,
      "Marker": "Marker",
      "MarkerId": "rifles",
      "Text": "Select me, then click the truck",
      "AtUnit": "Rifles"
     }
    ]
   },
   {
    "Name": "Rifles aboard",
    "Enabled": true,
    "Condition": 30,
    "Actions": [
     {
      "Type": 3,
      "MarkerId": "rifles"
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Scout",
        "Text": "He's aboard. Boarding used his turn, but not the truck's.",
        "Sound": "",
        "Portrait": 1
       },
       {
        "Character": "Placeholder Commander",
        "Text": "Away from the HQ our units run out of supplies, so we take supply along. Put the supply unit in the truck too: select it, then click the truck.",
        "Sound": "",
        "Portrait": 0
       }
      ]
     },
     {
      "Type": 2,
      "Marker": "Marker",
      "MarkerId": "supply",
      "Text": "Load me too",
      "AtUnit": "Supply"
     }
    ],
    "Side": -2,
    "UnitTag": "Rifles"
   },
   {
    "Name": "Supply aboard",
    "Enabled": true,
    "Condition": 30,
    "Actions": [
     {
      "Type": 3,
      "MarkerId": "supply"
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Scout",
        "Text": "Supply aboard. While the truck stays within one drive of supplied ground, everyone around the truck is in supply.",
        "Sound": "",
        "Portrait": 1
       }
      ]
     }
    ],
    "Side": -2,
    "UnitTag": "Supply"
   },
   {
    "Name": "Loaded",
    "Enabled": true,
    "Condition": 18,
    "Actions": [
     {
      "Type": 3,
      "MarkerId": "rifles"
     },
     {
      "Type": 3,
      "MarkerId": "supply"
     },
     {
      "Type": 2,
      "Marker": "Marker",
      "MarkerId": "front",
      "Text": "Drive here",
      "TileX": 2,
      "TileY": 2
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Commander",
        "Text": "Both aboard. Select the truck and drive it up the road to the marked tile.",
        "Sound": "",
        "Portrait": 0
       }
      ]
     },
     {
      "Type": 17,
      "Trigger": "At the front"
     }
    ],
    "Parts": [
     "Rifles aboard",
     "Supply aboard"
    ]
   },
   {
    "Name": "At the front",
    "Enabled": false,
    "Condition": 1,
    "Actions": [
     {
      "Type": 3,
      "MarkerId": "front"
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Scout",
        "Text": "Here we are. The lit ground around the truck is in supply, thanks to the supply unit aboard: leave it in the truck.",
        "Sound": "",
        "Portrait": 1
       },
       {
        "Character": "Placeholder Scout",
        "Text": "Now put the grunt down. Click the truck: its panel shows who is aboard. Click the grunt there, then a tile beside the truck.",
        "Sound": "",
        "Portrait": 1
       }
      ]
     }
    ],
    "Side": -2,
    "UnitTag": "Truck",
    "TileX": 2,
    "TileY": 2,
    "Radius": 1
   },
   {
    "Name": "Rifles out",
    "Enabled": true,
    "Condition": 31,
    "Actions": [
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Scout",
        "Text": "On foot again. Getting out costs nothing, but he boarded this turn, so he is done for now.",
        "Sound": "",
        "Portrait": 1
       },
       {
        "Character": "Placeholder Commander",
        "Text": "End your turn. Help is on its way.",
        "Sound": "",
        "Portrait": 0
       }
      ]
     }
    ],
    "Side": -2,
    "UnitTag": "Rifles"
   },
   {
    "Name": "Lookout spotted",
    "Enabled": true,
    "Condition": 29,
    "Actions": [
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Scout",
        "Text": "Enemy spotted! A lookout, dug in on the village.",
