     },
     {
      "Type": 8,
      "Side": -2,
      "UnitKind": "Grunt",
      "TileX": -3,
      "TileY": 1,
      "Count": 1,
      "Value": 6,
      "Veterancy": 0,
      "UnitTag": "Scouts",
      "ReadyToAct": true
     },
     {
      "Type": 1,
