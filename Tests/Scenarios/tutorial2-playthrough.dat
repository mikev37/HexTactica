      "TileY": 2
     },
     {
      "Type": 0,
      "Lines": [
       {
        "Character": "Placeholder Commander",
        "Text": "Lookout down! Now take the village: move a grunt onto it and keep him there. Vehicles can't capture.",
        "Sound": "",
        "Portrait": 0
       }
      ]
     }
    ],
    "Side": -3,
    "UnitTag": "Lookout"
   },
   {
