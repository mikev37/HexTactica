            {
                "Name": "1.4b Moved elsewhere",
                "Enabled": true,
                "Condition": 18,
                "Actions": [
                    {
                        "Type": 3,
                        "MarkerId": "goal"
                    },
                    {
                        "Type": 0,
                        "Lines": [
