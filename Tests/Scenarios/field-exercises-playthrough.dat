            {
                "Name": "S3 No units left",
                "Enabled": true,
                "Condition": 22,
                "Actions": [
                    {
                        "Type": 7,
                        "Side": -2
                    }
                ],
                "Side": -2,
                "Value": 0
            },
            {
                "Name": "1.1 Introductions",
                "Enabled": true,
                "Condition": 0,
                "Actions": [
                    {
                        "Type": 1,
                        "AtUnit": "Alpha",
                        "Zoom": 0,
                        "Seconds": 1.0
                    },
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "Greetings, Commander. My name is Anna Mikhailovna from Federal Central Intelligence. Due to the proximity to the border with Blakia, this exercise is being closely monitored. You will be leading the Opposing Force, OPFOR. Your objective is to prove a worthy opponent for Commander Jori Orlov. Do not disappoint.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Jori",
                                "Text": "And don't bore me, either. I'm Jori Orlov. My father is the Minister of Defense. So, you know, don't feel bad when you lose. Try to make this last a bit. I like my opponents to have a little spirit before I break them.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Anna",
                                "Text": "Commander, a word. Focus on the objective.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Jori",
                                "Text": "What's a prize like you doing in a mud pit like this, Anna? Ditch this zero and come join a real man! I've got a bottle of real brandy and a bunk with your name on it. We can discuss strategy... after you've properly thanked me for saving you from this boredom.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Anna",
                                "Text": "You have the tactical acumen of a rutting goat, Jori. In your dreams.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Jori",
                                "Text": "Whatever. See you on the battlefield.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ]
            },
            {
                "Name": "1.2 Click Alpha",
                "Enabled": true,
                "Condition": 0,
                "Actions": [
                    {
                        "Type": 2,
                        "Marker": "Marker",
                        "MarkerId": "alpha",
                        "Text": "Click me",
                        "AtUnit": "Alpha"
                    },
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "Ignore what he said. Let's focus on the mission. Click on the marked squad, and move it to the staging ground, that sand pit over there.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ]
            },
            {
                "Name": "1.3 Alpha selected",
                "Enabled": true,
                "Condition": 26,
                "Actions": [
                    {
                        "Type": 3,
                        "MarkerId": "alpha"
                    },
                    {
                        "Type": 2,
                        "Marker": "Marker",
                        "MarkerId": "goal",
                        "Text": "Move here",
                        "TileX": 1,
                        "TileY": 1
                    },
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "The lit tiles are where he can reach this turn. Click on the staging ground to propose a move there.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ],
                "Side": -2,
                "UnitTag": "Alpha"
            },
            {
                "Name": "1.3b Confirm",
                "Enabled": true,
                "Condition": 34,
                "Actions": [
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "Then click again to confirm.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ],
                "InArea": true,
                "TileX": 1,
                "TileY": 1,
                "Radius": 0,
                "Side": -2,
                "UnitTag": "Alpha"
            },
            {
                "Name": "1.4 On the staging ground",
                "Enabled": true,
                "Condition": 1,
                "Actions": [
                    {
                        "Type": 3,
