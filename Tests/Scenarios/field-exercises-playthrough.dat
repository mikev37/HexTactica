                    },
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "This is bad. Our squad lost more than he dealt, so he fell back a tile: the side that loses more always falls back, if they can. But Jori's squad is far from his supply.",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Anna",
                                "Text": "Click our squad.",
                                "Sound": "",
