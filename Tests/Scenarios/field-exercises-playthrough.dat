            {
                "Name": "1.5 Hit",
                "Enabled": false,
                "Condition": 10,
                "Actions": [
                    {
                        "Type": 1,
                        "AtUnit": "Alpha",
                        "Zoom": 0,
                        "Seconds": 0.8
                    },
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "What? Our unit is injured!",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Jori",
                                "Text": "Hah! A unit's damage depends on its strength, so attacking first deals more damage! My unit hit yours for 3 damage, so yours could only retaliate for 1! The first mover advantage!",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ],
                "Value": 6,
                "Side": -2,
                "UnitTag": "Alpha"
            },
            {
                "Name": "1.6 That's his reach",
                "Enabled": true,
                "Condition": 35,
                "Actions": [
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Anna",
                                "Text": "Those lit tiles show where HE can move and hit, not you. Your squad can only hit the tile right next to it.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    }
                ],
                "Side": 112,
                "UnitTag": "Jori's Pride"
            },
            {
                "Name": "1.5b Jori takes the pit",
