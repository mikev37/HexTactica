    - target: {fileID: 3718294514905684263, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: m_Name
      value: Tutorial 2
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: title
      value: 'Tutorial 2: Wheels and Supply'
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: faction
      value: 
      objectReference: {fileID: 11400000, guid: 957a6ea74ab705140a10f5415891bc1e, type: 2}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: briefing
      value: 'The raiders hold the village at the end of the road. It is too far to walk and beyond the HQ''s supply: load a truck, carry supply to the front, bring up a recon car, and take the village.'
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: parKills
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: parTurns
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: scenario
      value: Tutorial 2
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: parLosses
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: objectives
      value: 'Carry a squad and the supply unit to the front by truck.

        Destroy the lookout.

        Capture the village with a grunt.'
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: availableAtStart
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: intro.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outro.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outroLost.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: intro.Array.data[0].Text
      value: The raiders hold a village down the road. Too far to walk, and too far from the HQ to stay supplied.
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: intro.Array.data[1].Text
      value: So we take a truck, and we take supply with us.
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outro.Array.data[0].Text
      value: 'That''s how an army moves: on wheels, with its supply behind it.'
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outro.Array.data[1].Text
      value: You're ready for the real thing.
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: intro.Array.data[0].Portrait
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: intro.Array.data[1].Portrait
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outro.Array.data[0].Portrait
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outro.Array.data[1].Portrait
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
      propertyPath: outroLost.Array.data[0].Text
      value: No squads left, no village. Keep them near the supply truck next time.
      objectReference: {fileID: 0}
    - target: {fileID: 7364205516402891153, guid: 6ac3376308d45044d9fddc0c6d58ff97, type: 3}
