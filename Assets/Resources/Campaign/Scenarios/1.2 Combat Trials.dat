                ]
            },
            {
                "Name": "S1 Jori has no units",
                "Enabled": false,
                "Condition": 22,
                "Actions": [
                    {
                        "Type": 0,
                        "Lines": [
                            {
                                "Character": "Jori",
                                "Text": "Grrr! This was a fluke! You hear me? A fluke! Wait until my father hears about this!",
                                "Sound": "",
                                "Portrait": 0
                            },
                            {
                                "Character": "Gena",
                                "Text": "He followed the rules. You, on the other hand, have a loose tongue, Orlov. Discipline your unit.",
                                "Sound": "",
                                "Portrait": 0
                            }
                        ]
                    },
                    {
                        "Type": 6,
                        "Side": -2
                    }
                ],
                "Side": 112,
                "Value": 0
            },
